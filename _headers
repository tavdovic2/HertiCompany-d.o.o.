# Cloudflare Pages – zaglavlja odgovora (https://developers.cloudflare.com/pages/configuration/headers/)
#
# HTML stranice nemaju ovdje posebno pravilo: Cloudflare ih po zadanom šalje s
# "Cache-Control: public, max-age=0, must-revalidate", pa posjetioci uvijek vide najnoviju verziju.

# Osnovna sigurnosna zaglavlja za sve adrese
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self'; connect-src 'self' https://api.web3forms.com; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

# Content-Security-Policy (CSP): stranica smije učitati samo svoje fajlove, Google Fonts i slati upit na Web3Forms.
# Zato u HTML-u NEMA <script>...</script> s kodom, onload="" ni style="" – sve je u js/ i css/stil.css.
# Ako dodate novu vanjsku uslugu (mapa, analitika, video), mora se dodati i ovdje, inače je preglednik blokira.

# CSS, JS i podaci: stranice ih učitavaju s ?v=<otisak sadržaja> (alati/generisi-stranice.js),
# pa se mogu pamtiti godinu dana – nakon izmjene se mijenja adresa.
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
/podaci/*
  Cache-Control: public, max-age=31536000, immutable

# Slike: 30 dana (adresa slike se ne mijenja kad se slika zamijeni, pa ne godinu dana)
/slike/*
  Cache-Control: public, max-age=2592000
